// PHON Phase 5 - MNIST inference example
// Weights generated by scripts/prepare_mnist.py
//
// Architecture: 28x28 = 784 -> 128 (relu) -> 10 (softmax)
//
// Weights are resolved relative to this file's directory.
// To run end-to-end, see examples/mnist/mnist_demo.py
// or: pytest tests/test_phase5_mnist.py -v

layer l1 {
    input: 784;
    output: 128;
    weights: "w1.npy";
    activation: relu;
}

layer l2 {
    input: 128;
    output: 10;
    weights: "w2.npy";
    activation: softmax;
}

flow main {
    // In production: band x = load("image.npy") @ phase 0;
    // For CLI testing, tensor is injected via Simulator.tensors["x"].
    band x = 1GHz @ phase 0;
    propagate(x) through l1 -> h1;
    propagate(h1) through l2 -> logits;
    return logits;
}

