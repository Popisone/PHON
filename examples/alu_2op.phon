medium silicon {
  temperature: 300K;
}

flow main {
  let a = 10;
  let b = 5;
  let op = 0; // 0 = ADD, 1 = SUB
  let result = 0;
  
  if op == 0 {
    let result = a + b;
  } else {
    let result = a - b;
  }
  
  // Демонстрация на while: преброяваме до резултата
  let i = 0;
  let count = 0;
  while i < result {
    let count = count + 1;
    let i = i + 1;
  }
  
  return count;
}
