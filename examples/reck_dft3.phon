// Generated by examples/reck_demo.py
// 3x3 DFT - Reck 1994 decomposition (N=3)
// Target U saved as reck_dft3_U.npy
// Usage: load U.npy, set sim.tensors['inp'] = basis_vector, then sim.run()
//
flow main {
  mzi_apply m1 { theta: 0.78539816339744828; phi: 3.1415926535897931; fiber: "inp"; i: 0; j: 2; }
  mzi_apply m2 { theta: 0.61547970867038737; phi: 0; fiber: "m1"; i: 0; j: 1; }
  mzi_apply m3 { theta: 0.78539816339744839; phi: -1.5707963267948966; fiber: "m2"; i: 1; j: 2; }
  phase_apply p1 { fiber: "m3"; mode: 0; phase: -3.1415926535897931; }
  phase_apply p2 { fiber: "p1"; mode: 1; phase: -0.52359877559829859; }
  phase_apply p3 { fiber: "p2"; mode: 2; phase: -2.617993877991494; }
}